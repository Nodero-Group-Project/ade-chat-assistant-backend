# Copy this file to app/.env and fill in your own values. DON'T COMMIT YOUR OWN .env FILE.

# Groq API key, used for dataset selection and URL generation: https://console.groq.com/keys
GROQ_API_KEY=

# StatsNZ API subscription key, sent as Ocp-Apim-Subscription-Key:
STAT_NZ_API_KEY=

# PostgreSQL connection string for the dataset table:
CONNECTION_STRING=postgresql://user:password@localhost:5432/ade_chat_assistant